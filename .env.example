# Copy this file to .env and fill it in. .env is git-ignored: never commit it.

# Local SQLite database file. Relative paths are inside this project folder.
DB_PATH=grades.db

# Your school, as shown in report headers and email subjects/signatures.
SCHOOL_NAME=Example International School
SCHOOL_SHORT_NAME=EIS
EMAIL_SIGNATURE=EIS IT Office

# Optional header image for the HTML grade reports (PNG). No logo if the file is missing.
REPORT_LOGO_FILE=report_logo.png

# Accounts that send the grade-report emails (one per school section).
# Use a Gmail / Google Workspace App Password (Google Account > Security > App passwords),
# never the account's real password. 2-Step Verification must be on to create one.
HS_SENDER_EMAIL=it@yourschool.edu
HS_SENDER_APP_PASSWORD=xxxx xxxx xxxx xxxx
JH_SENDER_EMAIL=jh-it@yourschool.edu
JH_SENDER_APP_PASSWORD=xxxx xxxx xxxx xxxx

# SMTP server (defaults shown; change only if you don't use Gmail / Google Workspace).
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
